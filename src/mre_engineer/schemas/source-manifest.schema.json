{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "reviewed_on": {
      "const": "2026-10-28"
    },
    "review_scope": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://[^ ]+$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "core_experiment",
              "core_chemistry",
              "supporting",
              "optional"
            ]
          },
          "format": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "rights_evidence": {
            "type": "string",
            "pattern": "^https://[^ ]+$"
          },
          "redistribution": {
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "download_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^https://[^ ]+$"
            }
          },
          "acquisition": {
            "const": "metadata_reviewed_files_not_acquired"
          }
        },
        "required": [
          "id",
          "title",
          "url",
          "version",
          "role",
          "format",
          "license",
          "rights_evidence",
          "redistribution",
          "limitations",
          "download_urls",
          "acquisition"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "reviewed_on",
    "review_scope",
    "sources"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
